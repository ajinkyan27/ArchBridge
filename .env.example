# Copy to .env.local for development, or .env.production.local for a production build.
# These NEXT_PUBLIC_* values are compiled into the public static site.
# NEVER put secrets, API keys or AWS credentials in this file.

# Canonical site origin (no trailing slash). Used for canonical URLs, Open Graph, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://arcbridgeanalytics.com

# Public URL of the deployed contact API (output "ContactApiUrl" of the SAM stack).
# Leave empty to show the honest "online enquiries are not enabled yet" state.
# For local testing with `npm run contact:local`: http://localhost:8787/enquiries
NEXT_PUBLIC_CONTACT_API_URL=

# Optional public email shown on the contact page and footer. Leave empty to hide.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional LinkedIn company page URL. Leave empty to hide.
NEXT_PUBLIC_LINKEDIN_URL=

# Set to false for staging builds so search engines do not index them.
NEXT_PUBLIC_ALLOW_INDEXING=true
